extends layout

block content
  .container(style="margin-top: 50px;")
    .row
      .col.s12
        h2.center-align 🏎️ Descargar Videos F1
        p.center-align Videos de Formula 1 en alta calidad - Listos para redes sociales
    
    .row
      .col.s12.m6
        .card
          .card-content
            span.card-title
              i.material-icons.left videocam
              | Video Sin Música
            if videoExists
              p
                strong Formato: 
                | MP4 (1080x1920)
              p
                strong Duración: 
                | 15 segundos
              p
                strong FPS: 
                | 60 fps
              p
                strong Tamaño: 
                | #{videoSize} MB
              p
                strong Características:
              ul
                li ✓ 6 autos F1 animados
                li ✓ Efectos de velocidad
                li ✓ Texto dinámico
                li ✓ Calidad alta (CRF 18)
          .card-action
            if videoExists
              a.btn.waves-effect.waves-light.red(href="/download/video")
                i.material-icons.left file_download
                | Descargar Video
              a.btn.waves-effect.waves-light.blue(href="/download/stream/video" target="_blank" style="margin-left: 10px;")
                i.material-icons.left play_arrow
                | Ver Online
            else
              p.red-text
                i.material-icons.left error
                | Video no disponible
              p Genera el video primero:
              code node generate-f1-video.js
      
      .col.s12.m6
        .card
          .card-content
            span.card-title
              i.material-icons.left music_video
              | Video Con Música
            if videoWithMusicExists
              p
                strong Formato: 
                | MP4 (1080x1920)
              p
                strong Duración: 
                | 15 segundos
              p
                strong FPS: 
                | 60 fps
              p
                strong Tamaño: 
                | #{videoWithMusicSize} MB
              p
                strong Características:
              ul
                li ✓ Todo lo del video base
                li ✓ Audio de alta calidad
                li ✓ Listo para publicar
                li ✓ Optimizado para reels
          .card-action
            if videoWithMusicExists
              a.btn.waves-effect.waves-light.red(href="/download/video-with-music")
                i.material-icons.left file_download
                | Descargar Video
              a.btn.waves-effect.waves-light.blue(href="/download/stream/video-with-music" target="_blank" style="margin-left: 10px;")
                i.material-icons.left play_arrow
                | Ver Online
            else
              p.orange-text
                i.material-icons.left warning
                | Video con música no disponible
              p Agrega música al video:
              code node add-music.js /ruta/a/musica.mp3
    
    .row
      .col.s12
        .card.blue-grey.darken-3
          .card-content.white-text
            span.card-title
              i.material-icons.left info
              | Instrucciones
            h6 📹 Generar Video Base:
            pre(style="background: #263238; padding: 15px; border-radius: 5px;")
              code npm run generate-video
            
            h6(style="margin-top: 20px;") 🎵 Agregar Música:
            pre(style="background: #263238; padding: 15px; border-radius: 5px;")
              code npm run add-music /ruta/a/tu/musica.mp3
            
            h6(style="margin-top: 20px;") 📱 Subir a Redes Sociales:
            ul
              li
                strong Instagram Reels: 
                | Formato perfecto 1080x1920
              li
                strong TikTok: 
                | Vertical optimizado
              li
                strong YouTube Shorts: 
                | Alta calidad 60fps
            
            h6(style="margin-top: 20px;") 💡 Consejos:
            ul
              li Usa música sin copyright
              li Agrega hashtags: #F1 #Formula1 #Racing
              li Publica entre 6-9 PM para máximo alcance
              li Usa sonidos trending de tu plataforma
    
    .row
      .col.s12.center-align
        a.btn.waves-effect.waves-light.grey(href="/")
          i.material-icons.left home
          | Volver al Inicio

block afterjquery
  script.
    // Inicializar componentes de Materialize
    $(document).ready(function() {
      M.AutoInit();
    });
